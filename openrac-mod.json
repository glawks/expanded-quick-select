{
  "format": 2,
  "id": "expanded-quick-select",
  "name": "Expanded Quick Select",
  "version": "2.0.0-dev.7",
  "author": "glawks",
  "description": "Development: RAC1 native wheel and optional Weapon Wheel Pause bridge; experimental RAC2 prototype.",
  "type": "native",
  "api": "1.31",
  "games": {
    "rac1": [
      "pal",
      "ntsc"
    ],
    "rac2": [
      "ntsc"
    ]
  },
  "hooks": [
    "rac1.pad.process_report",
    "rac1.player.update",
    "rac1.hud.quick_select.init",
    "rac1.hud.quick_select.update",
    "rac1.hud.quick_select.draw",
    "rac1.menu.quick_select.load",
    "rac1.menu.item_slots.update",
    "rac1.menu.quick_select.store",
    "rac1.save.prepare",
    "rac1.save.restore",
    "rac1.save.new_game",
    "rac1.menu.quick_select.draw",
    "rac1.menu.item_text.draw",
    "rac2.item.give"
  ],
  "settings": [
    {
      "key": "wheel_count",
      "name": "Weapon wheels",
      "type": "choice",
      "default": "2",
      "choices": [
        {
          "value": "1",
          "name": "1 wheel"
        },
        {
          "value": "2",
          "name": "2 wheels"
        },
        {
          "value": "3",
          "name": "3 wheels"
        },
        {
          "value": "4",
          "name": "4 wheels"
        },
        {
          "value": "5",
          "name": "5 wheels"
        },
        {
          "value": "6",
          "name": "6 wheels"
        },
        {
          "value": "7",
          "name": "7 wheels"
        },
        {
          "value": "8",
          "name": "8 wheels"
        }
      ],
      "description": "Number of Quick Select pages (1-8). Restart the game after changing."
    },
    {
      "key": "rac2_experimental",
      "name": "Enable experimental RAC2 pages",
      "type": "bool",
      "default": false,
      "games": [
        "rac2"
      ],
      "description": "NTSC-U development only: attempt gameplay wheel page switching and fill extra pages from owned weapons. RAC2 pause-menu editing is not available. Back up saves."
    }
  ],
  "license": "MIT",
  "touch": "touch/quick-select.json"
}
